# PaperTiger configuration.
#
# Copy this file to `.env` and fill in your Alpaca PAPER keys. Get them from
# https://app.alpaca.markets (Paper Trading tab, after creating a paper
# account). Everything below defaults to safe, small, paper-only values --
# read config.py if you want to understand exactly how each value is used.

# --- Alpaca credentials & environment -------------------------------------

# Paper keys go here. Do NOT put live-account keys here unless you have
# deliberately decided to go live (see the two flags below) -- and even
# then, keep this file out of version control (it already is, see .gitignore).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# true = paper trading endpoint (default, safe). false = live/real money.
ALPACA_PAPER=true

# Both of these must be set for a live (non-paper) run to be allowed at all
# -- see config.Config.guard_live(). Leave them alone unless you have
# specifically decided to risk real money, understand you can lose it, and
# have already run preflight.py + backtest.py + walkforward.py against a
# dedicated CASH account.
# I_UNDERSTAND_THIS_IS_REAL_MONEY=yes

# --- Strategy sleeves (see sleeves.py and README "Comparing strategies") ---
# The account is split into strategies ("sleeves"), each with its own pool of
# money and its own symbols -- no symbol ever belongs to two of them:
#   - the buy-and-hold core (SYMBOLS below, CORE_POOL_USD), bought once, never sold
#   - one signal sleeve per entry in STRATEGY_SLEEVES, each with SLEEVE_POOL_USD
# STRATEGY_SLEEVES empty = just SIGNAL_KIND (one signal sleeve). Listing
# several runs them side by side for comparison (the dashboard's Compare
# tab) -- a PAPER-trading experiment: with ALPACA_PAPER=false the engine
# refuses more than one unless you ALSO set ALLOW_MULTI_STRATEGY_LIVE=yes.
# Which symbols each sleeve trades is written once to SLEEVES_FILE_PATH by
# scripts/start_sleeve_experiment.py (no sleeves file = no signal trading).
STRATEGY_SLEEVES=sma_crossover,rsi_reversion,ml_classifier
CORE_POOL_USD=500
SLEEVE_POOL_USD=500
SLEEVES_FILE_PATH=sleeves.json
SLEEVE_HISTORY_FILE_PATH=sleeve_history.jsonl
# ALLOW_MULTI_STRATEGY_LIVE=yes
# Each signal sleeve's sizing, as a FRACTION OF ITS OWN POOL (0.13 = 13% =
# $65 of a $500 pool). Defaults match the "normal" risk profile; picking a
# profile on the dashboard's Config tab overrides these live (see
# safety.RISK_PROFILE_PRESETS). Trade size x MAX_OPEN_POSITIONS is roughly
# how much of a pool can be invested at once.
TRADE_SIZE_PCT=0.13
MAX_POSITION_PCT=0.18
CASH_BUFFER_PCT=0.03

# --- Capital & sizing (small-seed defaults) --------------------------------

# These dollar values size the OFFLINE tools (backtest.py, walkforward.py,
# train_ml_signal.py; SEED_USD is their starting capital). The live signal
# sleeves use the *_PCT fractions above instead; CASH_BUFFER_USD also guards
# the core's one-time buy.
SEED_USD=200.0
TARGET_TRADE_USD=25.0
MIN_NOTIONAL_USD=5.0
MAX_POSITION_USD=60.0
MAX_CONCENTRATION_PCT=0.35
CASH_BUFFER_USD=10.0

# --- Circuit breakers (software safety layer -- see safety.py) ------------

DAILY_LOSS_LIMIT_PCT=0.03
MAX_DRAWDOWN_PCT=0.15
# What hitting either limit above does. "flatten" (default) cancels open
# orders and sells everything to cash -- the safe choice with real money.
# "halt" stops new buys but keeps every position, so a strategy comparison
# survives one bad market day instead of being wiped back to cash. Either
# way trading stays stopped until you clear it on the dashboard, and clearing
# it re-arms both limits from that moment.
BREAKER_ACTION=flatten
MAX_CONSECUTIVE_ERRORS=3
# The two limits above act on the strategies' money (every sleeve together),
# not the whole account -- a paper account holds far more than they're given.
# Cap on distinct symbols EACH signal sleeve can hold at once -- keeps a wide
# symbol list from turning into a pile of tiny buys. This, like the other
# risk-appetite fields above, applies equally to every sleeve and can also
# be overridden live from the dashboard's Config tab via a conservative/
# normal/aggressive profile -- see RISK_PROFILE_FILE_PATH below and safety.py.
MAX_OPEN_POSITIONS=6

# --- Market data / execution sanity ---------------------------------------

QUOTE_MAX_AGE_SEC=60
LIMIT_OFFSET_PCT=0.05

# --- Loop / operational ----------------------------------------------------

# The underlying signal is a DAILY-bar signal (history only refreshes once
# per day), so ticking every 60s bought nothing except more API calls and
# dashboard event-log noise -- 300s (5 min) is still plenty responsive for
# kill-switch/circuit-breaker checks without hammering the endpoint.
LOOP_INTERVAL_SEC=300
# The buy-and-hold core sleeve's symbols. SPY/QQQ/VTI/IVV are all broad U.S.
# equity index funds (correlation ~0.85-0.99 to each other) -- BND (bonds)
# and GLD (gold) were added 2026-08-24 to give the core genuinely
# uncorrelated names instead of four bets on the same thing. No signal sleeve
# ever trades these. REVISIT THIS LIST before ever going live with real money --
# it was picked for paper-mode learning/diversification testing, not
# deliberated as a live-money allocation.
SYMBOLS=SPY,QQQ,VTI,IVV,BND,GLD
KILL_FILE_PATH=HALT
STATE_FILE_PATH=runtime_state.json
HISTORY_LOOKBACK_DAYS=60

# Live-reloadable risk profile (conservative/normal/aggressive + manual
# per-field overrides), written by the dashboard's Config tab and read fresh
# every engine tick -- same fail-closed-if-missing/malformed pattern as the
# kill switch. See safety.RiskProfileStore. Never touches SYMBOLS, which
# symbols a sleeve trades, ALPACA_*, or the same-day round-trip check --
# those have no override path at all.
RISK_PROFILE_FILE_PATH=risk_profile.json

# --- Candidate stocks for the signal sleeves (see scripts/refresh_tactical_universe.py) ---
# CANDIDATE_UNIVERSE_FILE_PATH is a static, user-editable pool of liquid US
# stocks (with a sector for each). A weekly script ranks the currently-
# tradable candidates by dollar volume and writes the top
# TACTICAL_UNIVERSE_SIZE of them to TACTICAL_UNIVERSE_FILE_PATH.
# scripts/start_sleeve_experiment.py deals that ranked list out to the signal
# sleeves by sector, so each gets a similar mix (30 = about 10 each for three
# sleeves). The engine itself never reads it -- once an experiment starts,
# each sleeve's symbols stay fixed in SLEEVES_FILE_PATH.
CANDIDATE_UNIVERSE_FILE_PATH=candidate_universe.json
TACTICAL_UNIVERSE_FILE_PATH=tactical_universe.json
TACTICAL_UNIVERSE_SIZE=30
TACTICAL_UNIVERSE_LOOKBACK_DAYS=20

# --- Signal parameters (fed into signals.Signal) ---------------------------
# The bundled signals are textbook placeholders with no proven edge -- see
# signals.py and README.md. Changing these numbers does not fix that. Each
# signal sleeve uses the parameters for its own kind; SIGNAL_KIND itself only
# matters when STRATEGY_SLEEVES is empty, and for the offline tools.
#
# SIGNAL_KIND=sma_crossover (trend-following, uses SIGNAL_FAST/SIGNAL_SLOW)
# SIGNAL_KIND=rsi_reversion (mean-reversion, uses SIGNAL_PERIOD/SIGNAL_OVERSOLD/SIGNAL_OVERBOUGHT)

SIGNAL_KIND=sma_crossover
SIGNAL_FAST=10
SIGNAL_SLOW=30

# Only read when SIGNAL_KIND=rsi_reversion:
SIGNAL_PERIOD=14
SIGNAL_OVERSOLD=30
SIGNAL_OVERBOUGHT=70

# SIGNAL_KIND=ml_classifier -- EXPERIMENTAL. Loads a scikit-learn model
# trained by train_ml_signal.py and buys/sells based on its predicted
# probability that price will be higher in a few trading days. Treat any
# good-looking backtest from this signal with EXTRA skepticism, not less --
# see ml_signal.py's module docstring. Only read when SIGNAL_KIND=ml_classifier:
SIGNAL_MODEL_PATH=ml_model.joblib
SIGNAL_ML_BUY_THRESHOLD=0.55
SIGNAL_ML_SELL_THRESHOLD=0.45

# --- Core holdings (see core.py) --------------------------------------------
# How many shares of each core symbol belong to the buy-and-hold core sleeve.
CORE_HOLDINGS_FILE_PATH=core_holdings.json
# Core-satellite split for the OFFLINE tools only (backtest.py,
# walkforward.py): this fraction of SEED_USD is buy-and-held in their
# simulations. The live engine sizes core from CORE_POOL_USD instead.
CORE_ALLOCATION_PCT=0.5

# --- Notifications (see notify.py) -- entirely optional, entirely free -----
# Leave NOTIFY_SMTP_HOST blank to disable email/SMS entirely (a local
# notifications.json is still written either way, for scripts/tray_notifier.ps1
# to show a system-tray balloon while you're at the PC).
#
# Fires on: engine HALT (consecutive errors, unrecognized order) and FLATTEN
# (circuit breaker tripped), and watchdog-triggered HALT (stale heartbeat).
#
# Gmail example (needs an "app password", not your real password -- generate
# one at https://myaccount.google.com/apppasswords, requires 2FA enabled):
#   NOTIFY_SMTP_HOST=smtp.gmail.com
#   NOTIFY_SMTP_PORT=587
#   NOTIFY_SMTP_USERNAME=you@gmail.com
#   NOTIFY_SMTP_PASSWORD=<16-char app password>
#   NOTIFY_FROM_EMAIL=you@gmail.com
#
# NOTIFY_TO accepts a comma-separated list of email addresses AND/OR carrier
# email-to-SMS gateway addresses -- the latter delivers as a free text message,
# no SMS service or API key needed:
#   Verizon:    5551234567@vtext.com
#   AT&T:       5551234567@txt.att.net
#   T-Mobile:   5551234567@tmomail.net
#   Sprint:     5551234567@messaging.sprintpcs.com
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=587
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_FROM_EMAIL=
NOTIFY_TO=
NOTIFY_LOCAL_FILE_PATH=notifications.json

# --- Durable trade history (see trade_log.py) ------------------------------
# Every order this bot submits (each sleeve's, and the core bootstrap) gets
# appended here as one JSON object per line -- independent of the rolling
# 200-entry in-memory event log and the broker's own order history.
TRADE_LOG_FILE_PATH=trade_history.jsonl

# --- Live equity/positions history (see equity_history.py) ----------------
# One snapshot (equity, cash, per-symbol position value) is appended here
# every engine tick, pruned to the last 35 days automatically -- this is
# what feeds the dashboard's Live tab "Last 30 Days" performance chart.
EQUITY_HISTORY_FILE_PATH=equity_history.jsonl
